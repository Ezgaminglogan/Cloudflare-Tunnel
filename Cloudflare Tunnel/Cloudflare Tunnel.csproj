<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cloudflare_Tunnel</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>


  <ItemGroup>
    <None Remove="ngrok\ngrok.exe" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cloudflare Tunnel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="cloudflare\cloudflared.exe">
      <LogicalName>cloudflare.cloudflared.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ngrok\ngrok.exe">
      <LogicalName>ngrok.ngrok.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
  