## =======================================================================
## .gitignore - Cloudflare & Ngrok Tunnel Manager (.NET 10 / Windows)
## =======================================================================

# --------------------------------------------------
# Build and Output Directories
# --------------------------------------------------
[Bb]in/
[Oo]bj/
[Pp]ublish/
[Oo]ut/
build/

# --------------------------------------------------
# Visual Studio
# --------------------------------------------------
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.dbmdl
*.jfm

# Visual Studio build reports & test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.aps

# --------------------------------------------------
# Visual Studio Code
# --------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --------------------------------------------------
# JetBrains Rider / Resharper
# --------------------------------------------------
.idea/
*.sln.iml

# --------------------------------------------------
# NuGet & Packages
# --------------------------------------------------
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# --------------------------------------------------
# Executables & Binaries Exception Handling
# CRITICAL: Preserve embedded engines in the repository
# --------------------------------------------------
*.exe
*.dll
*.so
*.dylib

# Explicitly UNIGNORE embedded tunnel engines required by the project
!Cloudflare Tunnel/cloudflare/cloudflared.exe
!Cloudflare Tunnel/ngrok/ngrok.exe

# --------------------------------------------------
# Local Runtime Cache & User Data
# --------------------------------------------------
# Local runtime binary extraction & stored tokens
# (Located in %LOCALAPPDATA%\UniversalTunnel on Windows)
.universal-tunnel/
*.local.json
secrets.json

# --------------------------------------------------
# OS & File System Artifacts
# --------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
